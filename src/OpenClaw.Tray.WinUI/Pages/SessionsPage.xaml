<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClawTray.Pages.SessionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="HeaderText" Text="Sessions" Style="{StaticResource SubtitleTextBlockStyle}" Grid.Row="0"/>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyText" Text="No active sessions" Grid.Row="1"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed"/>

        <!-- Sessions list -->
        <ListView x:Name="SessionsList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"
                            Padding="16" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding AgeText}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="{Binding ThinkingText}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                    <TextBlock Text="{Binding VerboseText}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="Reset" Tag="{Binding Key}" Click="OnResetSession"
                                        Style="{StaticResource DefaultButtonStyle}"/>
                                <Button Content="Compact" Tag="{Binding Key}" Click="OnCompactSession"
                                        Style="{StaticResource DefaultButtonStyle}"/>
                                <Button Content="Delete" Tag="{Binding Key}" Click="OnDeleteSession"
                                        Visibility="{Binding DeleteVisibility}"
                                        Style="{StaticResource DefaultButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
