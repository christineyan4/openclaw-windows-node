<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="600">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- Connection -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Connection" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBox x:Name="GatewayUrlBox" Header="Gateway URL" PlaceholderText="ws://localhost:18789"/>
                    <PasswordBox x:Name="TokenBox" Header="Token" PlaceholderText="Gateway auth token"/>
                </StackPanel>
            </Border>

            <!-- Startup -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Startup" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ToggleSwitch x:Name="AutoStartToggle" Header="Start with Windows"/>
                    <ToggleSwitch x:Name="HotkeyToggle" Header="Global hotkey"/>
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Notifications" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ToggleSwitch x:Name="NotificationsToggle" Header="Show notifications"/>
                </StackPanel>
            </Border>

            <!-- Node -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Node" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ToggleSwitch x:Name="NodeModeToggle" Header="Enable node mode"/>
                    <ToggleSwitch x:Name="McpToggle" Header="Enable MCP server"/>
                </StackPanel>
            </Border>

            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" HorizontalAlignment="Right"/>
        </StackPanel>
    </ScrollViewer>
</Page>
