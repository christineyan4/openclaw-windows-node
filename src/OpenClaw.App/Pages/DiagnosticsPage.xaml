<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpenClaw.App.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <TextBlock Text="Diagnostics" Style="{StaticResource TitleTextBlockStyle}"/>

            <!-- Gateway info -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Gateway" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock x:Name="GatewayUrlText" Text="Not connected"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="GatewayVersionText" Text=""
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Channel health -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Channel Health" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ListView x:Name="ChannelList">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Summary}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoChannelsText" Text="No channel data"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Open Log Folder" Click="OnOpenLogFolder"/>
                <Button Content="Copy Diagnostics" Click="OnCopyDiagnostics"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
